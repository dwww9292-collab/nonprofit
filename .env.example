# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.
#
#   cp .env.example .env
#
# JWT_SECRET 생성:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- 필수 (없으면 기동 실패) ---
DATABASE_URL=postgresql+psycopg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/npo_sales
JWT_SECRET=
ADMIN_PASSWORD=

# --- 선택 ---
ADMIN_EMAIL=admin@example.com
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# docker compose 전용 (DB 컨테이너 초기화에 사용)
POSTGRES_USER=npo
POSTGRES_PASSWORD=
POSTGRES_DB=npo_sales

# --- 프론트엔드 (빌드 시점) ---
# 비워두면 동일 오리진(/api)으로 호출한다. nginx가 백엔드로 프록시하는 기본 구성에 맞다.
VITE_API_BASE=

# --- 사내 서버 운영 전용 (docs/08-deploy.md) ---
# docker-compose.server.yml 과 함께 쓸 때만 의미가 있다.
# BIND_ADDR: 프론트 포트를 어느 주소에 열지. 0.0.0.0 이면 사내망 전체,
#            127.0.0.1 이면 서버 자신만(Tailscale serve 로 중계할 때 권장).
BIND_ADDR=127.0.0.1
HTTP_PORT=3000

# --- 인터넷 공개 전용 (docs/09-deploy-aws.md) ---
# docker-compose.aws.yml 과 함께 쓸 때만 의미가 있다. Caddy 가 앞에서 HTTPS 를
# 처리하므로 BIND_ADDR 은 127.0.0.1 로 둔다.
# SITE_ADDRESS: 도메인(npo.example.co.kr) → Let's Encrypt 자동 발급.
#               도메인이 없으면 ":80" (HTTP, 임시용 — 비밀번호가 평문으로 흐른다)
SITE_ADDRESS=
ACME_EMAIL=
